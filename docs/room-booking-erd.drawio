  <diagram id="p0" name="00 วิธีอ่านและภาพรวม">
    <mxGraphModel dx="1260" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2840" pageHeight="1430" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontSize=29;fontStyle=1;;fontColor=#4A1830" value="DataSci_Booking Diagram&#10;ชื่อภาษาอังกฤษ + คำอธิบายไทย + PK/FK + เส้นเชื่อม" vertex="1">
          <mxGeometry height="100" width="2650" x="50" y="30" as="geometry" />
        </mxCell>
        <mxCell id="l0" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="PK — Primary Key" vertex="1">
          <mxGeometry height="95" width="530" x="50" y="160" as="geometry" />
        </mxCell>
        <mxCell id="v0" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="รหัสหลัก: ระบุข้อมูลแต่ละแถว ห้ามซ้ำและต้องมีค่า เช่น users.id" vertex="1">
          <mxGeometry height="95" width="2120" x="580" y="160" as="geometry" />
        </mxCell>
        <mxCell id="l1" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="FK — Foreign Key" vertex="1">
          <mxGeometry height="95" width="530" x="50" y="265" as="geometry" />
        </mxCell>
        <mxCell id="v1" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="รหัสอ้างอิง: เชื่อมไปยังอีกตาราง เช่น bookings.user_id → users.id" vertex="1">
          <mxGeometry height="95" width="2120" x="580" y="265" as="geometry" />
        </mxCell>
        <mxCell id="l2" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="PK, FK" vertex="1">
          <mxGeometry height="95" width="530" x="50" y="370" as="geometry" />
        </mxCell>
        <mxCell id="v2" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="ช่องเดียวเป็นทั้งรหัสหลักและรหัสอ้างอิง เช่น student_profiles.user_id" vertex="1">
          <mxGeometry height="95" width="2120" x="580" y="370" as="geometry" />
        </mxCell>
        <mxCell id="l3" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="UQ — Unique" vertex="1">
          <mxGeometry height="95" width="530" x="50" y="475" as="geometry" />
        </mxCell>
        <mxCell id="v3" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="ข้อมูลหรือคู่ข้อมูลห้ามซ้ำ แสดงในบรรทัดกฎท้ายตาราง" vertex="1">
          <mxGeometry height="95" width="2120" x="580" y="475" as="geometry" />
        </mxCell>
        <mxCell id="l4" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="เส้นเชื่อม" vertex="1">
          <mxGeometry height="125" width="530" x="50" y="580" as="geometry" />
        </mxCell>
        <mxCell id="v4" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="ด้านตารางต้นทาง: 1 = ต้องมีหนึ่งรายการ / 0..1 = เว้นว่างได้&#10;ด้านตารางปลายทาง: 0..* = มีได้หลายรายการ หรือยังไม่มีเลย" vertex="1">
          <mxGeometry height="125" width="2120" x="580" y="580" as="geometry" />
        </mxCell>
        <mxCell id="l5" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="เส้นชมพูเข้ม / เส้นประชมพูอ่อน" vertex="1">
          <mxGeometry height="125" width="530" x="50" y="715" as="geometry" />
        </mxCell>
        <mxCell id="v5" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="ชมพูเข้ม = ความสัมพันธ์ของงานหลัก, ประชมพูอ่อน = ผู้ทำรายการ เช่น ผู้รับรองหรือผู้ยกเลิก&#10;เส้นต่อจากแถวรหัสต้นทางไปยังแถว FK ที่อ้างถึงโดยตรง" vertex="1">
          <mxGeometry height="125" width="2120" x="580" y="715" as="geometry" />
        </mxCell>
        <mxCell id="l6" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="หนึ่งแถวในกล่องนี้คืออะไร" vertex="1">
          <mxGeometry height="125" width="530" x="50" y="850" as="geometry" />
        </mxCell>
        <mxCell id="v6" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="หนึ่งแถวในภาพ = หนึ่งช่องข้อมูล (คอลัมน์ของฐานข้อมูล)&#10;ตัวอย่าง: ตาราง users เก็บคนหลายคน แต่แต่ละคนมีช่อง id, full_name, email เหมือนกัน" vertex="1">
          <mxGeometry height="125" width="2120" x="580" y="850" as="geometry" />
        </mxCell>
        <mxCell id="l7" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="ข้อกำหนดร่วม" vertex="1">
          <mxGeometry height="125" width="530" x="50" y="985" as="geometry" />
        </mxCell>
        <mxCell id="v7" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="Manager มีได้ไม่เกินหนึ่งบัญชี และกำหนดให้พี่โอ, ผู้ใช้เลือกสิทธิ์เองไม่ได้&#10;เวลาเริ่มต้องก่อนเวลาจบ, จำนวนต้องถูกต้อง, ป้องกันห้องและอุปกรณ์ทับเวลาในฐานข้อมูล&#10;ร่างนี้ให้ Pending กันเวลาห้องด้วย, สถานะผ่านกิจกรรมต้องมีผู้รับรอง" vertex="1">
          <mxGeometry height="125" width="2120" x="580" y="985" as="geometry" />
        </mxCell>
        <mxCell id="l8" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="ขอบเขตฉบับนี้" vertex="1">
          <mxGeometry height="125" width="530" x="50" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="v8" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="21 ตาราง พร้อมปรับรายละเอียดตามกติกาการจองและปฏิทินกลาง แบ่ง 9 หน้ารายละเอียด, ตารางที่ปรากฏซ้ำคือข้อมูลชุดเดียวกัน ไม่ต้องสร้างซ้ำ&#10;ชื่ออังกฤษของช่องตรงกับแบบเดิม; คำอธิบายช่วยให้ทีมที่ไม่ใช่นักพัฒนาอ่านได้&#10;ยังไม่รวมจองซ้ำ บล็อกเวลา และเอกสารแนบการจองจากเดโมเดิม, ต้อง mapping rooms กับโค้ดเดิมก่อนใช้จริง" vertex="1">
          <mxGeometry height="125" width="2120" x="580" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="l9" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fontStyle=1;fillColor=#F8BBD0;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="หมายเหตุสำหรับทีมพัฒนา" vertex="1">
          <mxGeometry height="125" width="530" x="50" y="1255" as="geometry" />
        </mxCell>
        <mxCell id="v9" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;spacing=15;fillColor=#FFF1F6;strokeColor=#E6A1BC;fontSize=18;;fontColor=#4A1830" value="credential_secret_ref อ้างถึงข้อมูลเชื่อม Google ที่ป้องกันแล้ว ไม่ใช่รหัสผ่าน&#10;OTP/session ใช้โครงตามเครื่องมือ auth ที่เลือก, updated_at ต้องอัปเดตจริงด้วย Backend/trigger&#10;audit entity_id เป็นการอ้างอิงทั่วไป ไม่ใช่ FK, ห้ามลบประวัติอ้างอิงโดยไม่กำหนดนโยบาย" vertex="1">
          <mxGeometry height="125" width="2120" x="580" y="1255" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
